rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }
    // Medlem: står på medlemslisten (samlingen members), eller er administrator.
    function isMember() {
      return signedIn() && (isAdmin() || exists(/databases/$(database)/documents/members/$(request.auth.token.email)));
    }
    // Gruppeledere: medlemmer med feltet leads på oppføringen sin i members (satt av administrator). De kan opprette, endre og slette
    // nyheter og arrangementer som bare gjelder grupper de leder (groups er ikke tom og ligger innenfor leads, og innholdet er medlemsinnhold).
    function myLeads() {
      return get(/databases/$(database)/documents/members/$(request.auth.token.email)).data.get('leads', []);
    }
    function isLeader() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.token.email)) && myLeads().size() > 0;
    }
    function ledGroups(g) {
      return g is list && g.size() > 0 && g.hasOnly(myLeads());
    }
    // Åpent innhold kan alle lese. Innhold merket m == true krever at brukeren er medlem.
    match /{col}/{id} {
      allow read: if col in ['events', 'posts', 'regular'] && (resource.data.m == false || isMember());
      allow write: if col in ['events', 'posts', 'regular'] && isAdmin();
      allow create: if col in ['events', 'posts'] && isLeader() && ledGroups(request.resource.data.get('groups', [])) && request.resource.data.get('m', false) == true;
      allow update: if col in ['events', 'posts'] && isLeader() && ledGroups(resource.data.get('groups', [])) && ledGroups(request.resource.data.get('groups', [])) && request.resource.data.get('m', false) == true;
      allow delete: if col in ['events', 'posts'] && isLeader() && ledGroups(resource.data.get('groups', []));
    }
    // Sikkerhetspunkter for tilbakerulling (bare administratorer): oversikt i snapshots, innholdet som tekst i snapshotData.
    match /snapshots/{id} { allow read, write: if isAdmin(); }
    match /snapshotData/{id} { allow read, write: if isAdmin(); }
    // «Jeg kommer»-teller per arrangement. Alle kan lese og endre tallet med ett om gangen, bare administratorer kan slette.
    match /rsvpCounts/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n is int && request.resource.data.n >= 0
        && (request.resource.data.n - resource.data.n == 1 || resource.data.n - request.resource.data.n == 1);
      allow delete: if isAdmin();
    }
    // Varselkoder for push. Besøkende kan registrere en enhet, men aldri tildele seg grupper (groups må være tom). En innlogget bruker
    // kan koble koden til sin egen e-post (email), og bare sin egen. Gruppene hentes fra brukerens oppføring i members/admins, aldri herfra. Koden er
    // dokument-ID og må ha lengde som en ekte FCM-kode. Å slette krever at man kjenner koden (den er hemmelig for enheten).
    // Bare administratorer kan lese listen eller sette grupper. Dette hindrer ikke at fremmede legger inn søppelkoder.
    // Kategorier for arrangementer og faste samlinger: alle kan lese, bare administratorer endrer.
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Grupper (navn og beskrivelse): alle kan lese, bare administratorer endrer.
    match /groups/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Påminnelser før samlinger. Alle kan opprette og slette (id-en inneholder en del av varselkoden); bare administratorer/scriptet leser.
    match /reminders/{id} {
      allow create: if request.resource.data.keys().hasOnly(['token', 'title', 'fireAt', 'created'])
        && request.resource.data.token is string && request.resource.data.token.size() >= 100 && request.resource.data.token.size() <= 500
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.fireAt is int
        && request.resource.data.created == request.time;
      allow delete: if true;
      allow read, update: if isAdmin();
    }

    match /pushTokens/{token} {
      allow create, update: if request.resource.data.keys().hasOnly(['token', 'groups', 'created', 'email'])
        && request.resource.data.token == token
        && token.size() >= 100 && token.size() <= 500
        && request.resource.data.groups is list && request.resource.data.groups.size() == 0
        && request.resource.data.created == request.time
        && (!('email' in request.resource.data) || (signedIn() && request.resource.data.email == request.auth.token.email));
      allow delete: if true;
      allow read, write: if isAdmin();
    }
    // Medlemslisten: e-postadressen er dokument-ID. Brukeren kan sjekke sin egen adresse, administratorer styrer listen.
    match /members/{email} {
      allow get: if signedIn() && request.auth.token.email == email || isAdmin();
      allow list, write: if isAdmin();
    }
    // Administratorer er dokumenter i admins, med e-postadressen som dokument-ID. Bare administratorer kan endre listen.
    match /admins/{email} {
      allow get: if signedIn() && request.auth.token.email == email || isAdmin();
      allow list, write: if isAdmin();
    }
  }
}
